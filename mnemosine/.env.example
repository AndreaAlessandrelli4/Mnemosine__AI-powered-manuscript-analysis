# ──────────────────────────────────────────────
# Mnemosine — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── Inference Provider ──────────────────────
# "openai" (default, for demo/testing) or "hf" (local HuggingFace models)
INFERENCE_PROVIDER=openai

# ── OpenAI Configuration ───────────────────
OPENAI_API_KEY=your_openai_key_here
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# ── Google Configuration ───────────────────
GOOGLE_API_KEY=your_google_key_here
GOOGLE_VISION_MODEL=gemini-2.5-flash
GOOGLE_TEXT_MODEL=gemini-2.5-flash

# ── Anthropic Configuration ───────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_VISION_MODEL=claude-3-5-haiku-latest
CLAUDE_TEXT_MODEL=claude-3-5-haiku-latest

# ── Qwen Configuration (Alibaba DashScope) ─
QWEN_API_KEY=your_qwen_key_here
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus

# ── Manuscripts Root ───────────────────────
# Root directory containing manuscript folders.
# All browse/analyze operations are restricted to this path.
MANUSCRIPTS_ROOT=../../data

# ── Device Configuration ───────────────────
# Allowed devices for inference: auto, cpu, cuda, mps
ALLOWED_DEVICES=auto,cpu,cuda,mps

# ── Prompt Directory ───────────────────────
# Path to directory containing prompt .txt files
PROMPT_DIR=../prompt

# ── Server ─────────────────────────────────
HOST=0.0.0.0
PORT=8000
